# App Settings
PROJECT_NAME="FastAPI Authentication API"
DEBUG=true
API_V1_STR="/api/v1"

# Security Settings
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="change-me-to-a-super-secret-key-at-least-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastapi_auth_db

# SMTP / Email Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@example.com"
SMTP_FROM_NAME="FastAPI Auth Support"
EMAILS_ENABLED=false

# Stripe Billing Settings (Test Mode)